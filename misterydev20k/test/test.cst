// digital video
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

// SPI PSRAM
IO_LOC "psram_csn" 32;
IO_PORT "psram_csn" IO_TYPE=LVCMOS33;
IO_LOC "psram_clk" 69;
IO_PORT "psram_clk" IO_TYPE=LVCMOS33;
IO_LOC "psram_io[0]" 75;
IO_PORT "psram_io[0]" IO_TYPE=LVCMOS33;
IO_LOC "psram_io[1]" 76;
IO_PORT "psram_io[1]" IO_TYPE=LVCMOS33;
IO_LOC "psram_io[2]" 86;
IO_PORT "psram_io[2]" IO_TYPE=LVCMOS33;
IO_LOC "psram_io[3]" 10;
IO_PORT "psram_io[3]" IO_TYPE=LVCMOS33;

// ws2812 led
IO_LOC "ws2812" 79;
IO_PORT "ws2812" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
